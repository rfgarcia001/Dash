# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Recommended outside AI Studio.
# When DASHBOARD_PASSWORD is set with allowed domains/emails, the whole dashboard
# and API require login. Users enter their corporate email + this shared password.
DASHBOARD_ALLOWED_DOMAINS="allevotech.com,redealumni.com"
DASHBOARD_ALLOWED_EMAILS="pessoa externa@example.com"
DASHBOARD_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Optional fallback admin user, useful for emergency access.
DASHBOARD_USER="admin"

# Optional: when set, /api/spreadsheet reads ad/sale/creative data from this
# Postgres database instead of Google Sheets (see db/schema.sql). Unset by
# default — the app keeps reading from Sheets exactly as before. For local
# dev: `docker compose up -d postgres`, then this matches the compose file's
# credentials as-is.
# DATABASE_URL="postgres://allevo:allevo_dev_only@localhost:5432/allevo"

# Optional: when set, enables POST /api/ingest/meta and POST /api/ingest/vendas
# for external automations (N8N) to write into Postgres. Requires DATABASE_URL
# too. Callers send it in the X-Ingest-Token header — not the same credential
# as DASHBOARD_PASSWORD (that's for humans in the browser). See
# docs/ingest-api.md for the request/response contract.
# INGEST_API_TOKEN="CHANGE_ME_LONG_RANDOM_TOKEN"
